  <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Olly Warmth Limited - Online Booking</title>
    <!-- Tailwind CSS for Styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- html2pdf Library for Receipt Download -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-amber-50/50 min-h-screen text-slate-800 antialiased">

    <!-- Header -->
    <header class="bg-amber-900 text-amber-50 shadow-md">
        <div class="max-w-4xl mx-auto px-6 py-6 flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-bold tracking-tight">Olly Warmth Limited</h1>
                <p class="text-xs text-amber-200 mt-0.5">Premium Comfort & Warmth Services</p>
            </div>
            <span class="bg-amber-800 text-amber-200 text-xs px-3 py-1 rounded-full font-medium">24/7 Booking</span>
        </div>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-10">
        <!-- Booking Form Section -->
        <div id="bookingCard" class="bg-white rounded-2xl shadow-xl shadow-amber-900/5 p-8 border border-amber-100">
            <h2 class="text-xl font-bold text-amber-950 mb-6">Reserve Your Warmth Experience</h2>
            
            <form id="bookingForm" class="space-y-6">
                <!-- Personal Information -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">Full Name</label>
                        <input type="text" id="fullName" required placeholder="John Doe"
                            class="w-full px-4 py-2.5 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">Email Address</label>
                        <input type="email" id="email" required placeholder="john@example.com"
                            class="w-full px-4 py-2.5 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition">
                    </div>
                </div>

                <!-- Package & Guests -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">Warmth Package</label>
                        <select id="packageSelect" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition">
                            <option value="120" data-name="Cozy Hearth Suite">Cozy Hearth Suite - $120 / night</option>
                            <option value="200" data-name="Luxury Fireside Villa">Luxury Fireside Villa - $200 / night</option>
                            <option value="350" data-name="Warmth Haven Chalet">Warmth Haven Chalet - $350 / night</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">Number of Guests</label>
                        <input type="number" id="guests" min="1" max="10" value="2" required
                            class="w-full px-4 py-2.5 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition">
                    </div>
                </div>

                <!-- Dates -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">Check-in Date</label>
                        <input type="date" id="checkIn" required
                            class="w-full px-4 py-2.5 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-2">Check-out Date</label>
                        <input type="date" id="checkOut" required
                            class="w-full px-4 py-2.5 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition">
                    </div>
                </div>

                <!-- Total Estimation -->
                <div class="p-4 bg-amber-50 rounded-xl border border-amber-200 flex justify-between items-center">
                    <div>
                        <span class="text-xs text-amber-800 font-semibold uppercase tracking-wider">Estimated Total</span>
                        <p id="totalNights" class="text-xs text-slate-500">Select dates to calculate nights</p>
                    </div>
                    <div id="totalPrice" class="text-2xl font-bold text-amber-900">$0.00</div>
                </div>

                <button type="submit"
                    class="w-full bg-amber-600 hover:bg-amber-700 text-white font-semibold py-3.5 px-6 rounded-lg shadow-md hover:shadow-lg transition-all duration-200">
                    Confirm & Complete Booking
                </button>
            </form>
        </div>

        <!-- Success & Receipt View (Hidden by Default) -->
        <div id="confirmationSection" class="hidden space-y-6">
            <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-6 py-4 rounded-xl flex items-center justify-between">
                <div>
                    <h3 class="font-bold text-lg">Booking Confirmed!</h3>
                    <p class="text-sm">Thank you for booking with Olly Warmth Limited.</p>
                </div>
                <button onclick="downloadReceipt()" 
                    class="bg-amber-700 hover:bg-amber-800 text-white font-medium px-4 py-2 rounded-lg text-sm transition shadow">
                    Download PDF Receipt
                </button>
            </div>

            <!-- Receipt Card (Target for PDF download) -->
            <div id="receiptCard" class="bg-white p-8 rounded-2xl shadow-lg border border-slate-100 max-w-2xl mx-auto">
                <div class="border-b border-slate-200 pb-6 mb-6 flex justify-between items-start">
                    <div>
                        <h2 class="text-2xl font-bold text-amber-900">OLLY WARMTH LIMITED</h2>
                        <p class="text-xs text-slate-500 mt-1">Receipt & Reservation Confirmation</p>
                    </div>
                    <div class="text-right">
                        <span class="text-xs font-mono bg-slate-100 px-2.5 py-1 rounded text-slate-600" id="receiptID">#OWL-0000</span>
                        <p class="text-xs text-slate-400 mt-2" id="receiptDate">Date: --</p>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4 text-sm mb-6">
                    <div>
                        <p class="text-xs text-slate-400 uppercase font-semibold">Customer Details</p>
                        <p id="recName" class="font-medium text-slate-800 mt-1">-</p>
                        <p id="recEmail" class="text-slate-500 text-xs">-</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-400 uppercase font-semibold">Stay Details</p>
                        <p id="recNights" class="font-medium text-slate-800 mt-1">0 Nights</p>
                        <p id="recGuests" class="text-slate-500 text-xs">0 Guests</p>
                    </div>
                </div>

                <table class="w-full text-left text-sm mb-6 border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 text-xs uppercase text-slate-400">
                            <th class="py-2">Description</th>
                            <th class="py-2 text-right">Dates</th>
                            <th class="py-2 text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="border-b border-slate-100">
                            <td id="recPackage" class="py-3 font-medium text-slate-700">-</td>
                            <td id="recDates" class="py-3 text-right text-xs text-slate-500">-</td>
                            <td id="recBasePrice" class="py-3 text-right font-medium">$0.00</td>
                        </tr>
                    </tbody>
                </table>

                <div class="flex justify-end mb-6">
                    <div class="w-1/2 space-y-2 text-sm">
                        <div class="flex justify-between text-slate-500">
                            <span>Subtotal</span>
                            <span id="recSubtotal">$0.00</span>
                        </div>
                        <div class="flex justify-between text-slate-500">
                            <span>Taxes (10%)</span>
                            <span id="recTax">$0.00</span>
                        </div>
                        <div class="flex justify-between font-bold text-slate-800 border-t border-slate-200 pt-2">
                            <span>Total Paid</span>
                            <span id="recTotal" class="text-amber-900">$0.00</span>
                        </div>
                    </div>
                </div>

                <div class="text-center border-t border-slate-100 pt-6 text-xs text-slate-400">
                    <p>Thank you for choosing Olly Warmth Limited. We look forward to hosting you!</p>
                </div>
            </div>
        </div>
    </main>

    <script>
        // Set default dates (Today and Tomorrow)
        const checkInInput = document.getElementById('checkIn');
        const checkOutInput = document.getElementById('checkOut');
        
        const today = new Date();
        const tomorrow = new Date(today);
        tomorrow.setDate(tomorrow.getDate() + 1);

        checkInInput.value = today.toISOString().split('T')[0];
        checkOutInput.value = tomorrow.toISOString().split('T')[0];

        // Price Calculation Logic
        function calculateTotal() {
            const packageSelect = document.getElementById('packageSelect');
            const pricePerNight = parseFloat(packageSelect.value);
            
            const start = new Date(checkInInput.value);
            const end = new Date(checkOutInput.value);

            if (start && end && end > start) {
                const nights = Math.ceil((end - start) / (1000 * 60 * 60 * 24));
                const total = nights * pricePerNight;

                document.getElementById('totalNights').textContent = `${nights} Night(s) Stay`;
                document.getElementById('totalPrice').textContent = `$${total.toFixed(2)}`;
                return { nights, total, pricePerNight };
            } else {
                document.getElementById('totalNights').textContent = 'Invalid dates selected';
                document.getElementById('totalPrice').textContent = '$0.00';
                return { nights: 0, total: 0, pricePerNight: 0 };
            }
        }

        // Attach listeners for live calculation
        document.getElementById('bookingForm').addEventListener('input', calculateTotal);
        calculateTotal();

        // Form Submission
        document.getElementById('bookingForm').addEventListener('submit', function(e) {
            e.preventDefault();

            const { nights, total } = calculateTotal();
            if (nights <= 0) {
                alert('Please select valid check-in and check-out dates.');
                return;
            }

            const fullName = document.getElementById('fullName').value;
            const email = document.getElementById('email').value;
            const guests = document.getElementById('guests').value;
            const packageSelect = document.getElementById('packageSelect');
            const packageName = packageSelect.options[packageSelect.selectedIndex].getAttribute('data-name');

            // Tax Calculation
            const subtotal = total;
            const tax = subtotal * 0.10;
            const grandTotal = subtotal + tax;

            // Populate Receipt
            document.getElementById('receiptID').textContent = `#OWL-${Math.floor(100000 + Math.random() * 900000)}`;
            document.getElementById('receiptDate').textContent = `Date: ${new Date().toLocaleDateString()}`;
            document.getElementById('recName').textContent = fullName;
            document.getElementById('recEmail').textContent = email;
            document.getElementById('recNights').textContent = `${nights} Night(s)`;
            document.getElementById('recGuests').textContent = `${guests} Guest(s)`;
            document.getElementById('recPackage').textContent = packageName;
            document.getElementById('recDates').textContent = `${checkInInput.value} to ${checkOutInput.value}`;
            document.getElementById('recBasePrice').textContent = `$${subtotal.toFixed(2)}`;
            document.getElementById('recSubtotal').textContent = `$${subtotal.toFixed(2)}`;
            document.getElementById('recTax').textContent = `$${tax.toFixed(2)}`;
            document.getElementById('recTotal').textContent = `$${grandTotal.toFixed(2)}`;

            // UI Transition
            document.getElementById('bookingCard').classList.add('hidden');
            document.getElementById('confirmationSection').classList.remove('hidden');
        });

        // PDF Download Handler
        function downloadReceipt() {
            const element = document.getElementById('receiptCard');
            const opt = {
                margin:       0.5,
                filename:     'Olly_Warmth_Receipt.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2 },
                jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' }
            };

            html2pdf().set(opt).from(element).save();
        }
    </script>
</body>
</html>
